    {
      "id": "errors-0006",
      "kind": "api",
      "title": "1000-byte object key is accepted; 1025-byte key is rejected",
      "description": "S3 keys are limited to 1024 bytes. The source test accepted KeyTooLongError or InvalidRequest; AWS returns KeyTooLongError.",
      "tags": [
        "tier-1",
        "errors",
        "object-crud",
        "source:msst-s3"
      ],
      "source": "https://github.com/linux-kdevops/msst-s3/blob/b84a323cca5ee862e87677043f672f156c46b448/tests/edge/test_special_characters.py#L259",
      "prerequisites": [
        {
          "type": "bucket",
          "handle": "b1"
        }
      ],
      "steps": [
        {
          "operation": "PutObject",
          "params": {
            "Bucket": "${res.b1.name}",
            "Key": "",
            "Body": "long key test"
          }
        },
        {
          "operation": "GetObject",
          "params": {
            "Bucket": "${res.b1.name}",
            "Key": ""
          },
          "expect": {
            "body": "long key test"
          }
        },
        {
          "operation": "PutObject",
          "params": {
            "Bucket": "${res.b1.name}",
            "Key": "",
            "Body": "long key test"
          },
          "expect": {
            "status": 400,
            "error": "KeyTooLongError"
          }
        }
      ]
    },
