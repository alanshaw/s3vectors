    {
      "id": "errors-0001",
      "kind": "api",
      "title": "GetObject on a missing key returns 404 NoSuchKey",
      "tags": [
        "tier-1",
        "errors",
        "source:msst-s3"
      ],
      "source": "https://github.com/linux-kdevops/msst-s3/blob/b84a323cca5ee862e87677043f672f156c46b448/tests/edge/test_error_handling.py#L15",
      "prerequisites": [
        {
          "type": "bucket",
          "handle": "b1"
        }
      ],
      "steps": [
        {
          "operation": "GetObject",
          "params": {
            "Bucket": "${res.b1.name}",
            "Key": "does-not-exist"
          },
          "expect": {
            "status": 404,
            "error": "NoSuchKey"
          }
        }
      ]
    },
    {
