    {
      "id": "errors-0004",
      "kind": "api",
      "title": "PutObject with a key longer than 1024 bytes returns KeyTooLongError",
      "description": "Key is 1025 bytes of 'a'. The original test also tolerated InvalidRequest; AWS returns KeyTooLongError.",
      "tags": [
        "tier-1",
        "errors",
        "source:msst-s3"
      ],
      "source": "https://github.com/linux-kdevops/msst-s3/blob/b84a323cca5ee862e87677043f672f156c46b448/tests/edge/test_put_object_conditionals.py#L341",
      "prerequisites": [
        {
          "type": "bucket",
          "handle": "b1"
        }
      ],
      "steps": [
        {
          "operation": "PutObject",
          "params": {
            "Bucket": "${res.b1.name}",
            "Key": "",
            "Body": "data"
          },
          "expect": {
            "error": "KeyTooLongError"
          }
        }
      ]
    },
    {
      "id": "errors-0005",
      "kind": "api",
      "title": "PutObject to a non-existent bucket returns NoSuchBucket",
      "tags": [
        "tier-1",
        "errors",
